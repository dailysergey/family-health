# Copy to deploy/.env and adjust. This file is loaded by docker-compose.

# --- required ----------------------------------------------------------------
# PIN for the web UI. Any string; keep it out of screenshots.
HEALTH_PIN=1234

# Shared secret between Next.js /api/ingest and the health-ui MCP server.
# Generate a fresh one:  openssl rand -base64 32
HEALTH_INGEST_SECRET=change-me-generate-with-openssl-rand

# --- optional ---------------------------------------------------------------
# Host port to publish. Change if 3100 is taken.
HEALTH_PORT=3100

# Where family data lives on the host. Relative paths are resolved from
# the deploy/ directory. Use an absolute path for anything serious.
HEALTH_DATA_DIR=./data

# Claude Code CLI credentials on the host. These are mounted read-only into
# the container so the in-container `claude` can OAuth as you.
CLAUDE_DIR=~/.claude
CLAUDE_JSON=~/.claude.json

# ghealth (Google Health CLI) config on the host — used by wearables/sync.sh
# to pull data from Fitbit Air / Pixel Watch / etc. Optional; only matters
# if you enable wearables in family.json.
GHEALTH_CONFIG_DIR=~/.config/ghealth

# Timezone (matters if you add scheduled digests later).
TZ=Europe/Moscow

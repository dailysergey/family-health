# --- personal / runtime data (family medical records) ------------------------
# The `data/` directory holds actual family medical data (labs, diagnoses,
# scans, chat transcripts). NEVER commit this. Use `data.example/` as the
# template and copy it to `data/` on first run.
data/
!data.example/

# --- Claude Code local state -------------------------------------------------
.claude/
**/.claude/
!data.example/.mcp.json

# --- editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo


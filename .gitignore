# --- dependencies ------------------------------------------------------------
node_modules/
web/node_modules/
mcp/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- build / cache -----------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- env / secrets -----------------------------------------------------------
.env
.env.*
!.env.example
web/.env
web/.env.*

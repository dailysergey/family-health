# Обычно этот файл писать руками не нужно: ./install.sh задаст вопросы и заполнит .env сам.
# Здесь — то же самое для тех, кто ставит вручную.

# --- обязательное -----------------------------------------------------------
HEALTH_PIN=1234                         # PIN для веб-логина; любая строка
# Общий секрет между Next.js /api/ingest и health-ui MCP.
# Сгенерировать: openssl rand -base64 32
HEALTH_INGEST_SECRET=change-me-generate-with-openssl-rand

# --- опционально ------------------------------------------------------------
HEALTH_PORT=3100                        # порт публикации на хосте
HEALTH_DATA_DIR=./data                  # где на хосте лежат данные семьи
HEALTH_TMUX_SESSION=health              # имя tmux-сессии с claude REPL

# Креды Claude Code CLI на хосте — мапятся в контейнер, чтобы `claude` OAuth-нулся вами.
CLAUDE_DIR=~/.claude
CLAUDE_JSON=~/.claude.json
# Долгоживущий токен из `claude setup-token` (год). Задан — CLI авторизуется им и не
# зависит от OAuth-сессии в ~/.claude: на headless-хосте она однажды не обновляется
# и умирает молча, а агент начинает отвечать «Failed to authenticate».
CLAUDE_CODE_OAUTH_TOKEN=

# ghealth (Google Health CLI) конфиг на хосте — для wearables/sync.sh.
GHEALTH_CONFIG_DIR=~/.config/ghealth

TZ=Europe/Moscow

HEALTH_TAG=main                         # main — готовый образ из GHCR, local — сборка из исходников
